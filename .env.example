# Model Profile - Google Sheets Integration
# Deploy a Google Apps Script web app that accepts POST requests:
# - Action: getModel(modelId) -> returns { success: true, model: ModelProfile }
# - Action: getAllModels() -> returns { success: true, models: ModelProfile[] }
GOOGLE_SHEET_APP_SCRIPT_URL=https://script.google.com/macros/d/{SCRIPT_ID}/usercurrentappscript

# Google Sheets API (service account) - preferred
GOOGLE_SHEETS_SA_CLIENT_EMAIL=
GOOGLE_SHEETS_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=
# Optional: override sheet range (default Models!A1:Z)
GOOGLE_SHEETS_RANGE=Models!A1:Z

# Existing environment variables
NEXT_PUBLIC_API_URL=

# Apps Script endpoints
NEXT_PUBLIC_APPS_SCRIPT_UPLOAD_URL=
APPS_SCRIPT_SUBMIT_URL=
